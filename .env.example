# ─────────────────────────────────────────────────────────────
# TickerTalk environment configuration example
# Copy to .env and fill in your values: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── LLM provider (required) ──────────────────────────────────
# Options: anthropic | ollama | groq | gemini
LLM_PROVIDER=anthropic

# ── Anthropic (active) ───────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Other LLM providers (uncomment to switch) ────────────────
# OLLAMA_MODEL=llama3.2:latest
# OLLAMA_BASE_URL=http://localhost:11434
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# ── Stock data (optional — fetchers degrade gracefully) ──────
# ALPHA_VANTAGE_KEY=your-alpha-vantage-key-here
# STOCKDATA_KEY=your-stockdata-key-here

# ── Economic data (optional) ─────────────────────────────────
# FRED_API_KEY=your-fred-api-key-here

# ── News (optional) ──────────────────────────────────────────
# NEWS_API_KEY=your-news-api-key-here

# ── Reddit (optional — powers --wsb and the reddit agent) ────
# REDDIT_CLIENT_ID=your-reddit-client-id-here
# REDDIT_CLIENT_SECRET=your-reddit-client-secret-here
# REDDIT_USER_AGENT=TickTalker/1.0
